# Copie ce fichier en `.dev.vars` et remplis tes valeurs (mode test).
# `.dev.vars` alimente les bindings du Worker en local ; il n'est jamais commité.
# En production : `wrangler secret put <NOM>` pour chacune de ces variables.

# Clé secrète Stripe (mode test : sk_test_… ou rk_test_…).
STRIPE_SECRET_KEY=colle_ta_cle_secrete_stripe_ici

# Secret de signature du webhook Stripe. Dashboard Stripe → Developers →
# Webhooks → ton endpoint (/api/webhook) → « Signing secret ». Commence par whsec_…
STRIPE_WEBHOOK_SECRET=colle_ton_secret_webhook_stripe

# Clé API Resend — envoi de l'email de téléchargement après paiement.
# Dashboard Resend → API Keys. Commence par re_… Le domaine escape-print.fr
# doit être vérifié chez Resend (enregistrements DNS dans Cloudflare).
RESEND_API_KEY=colle_ta_cle_api_resend
