{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escape-print-site",
  "main": "./worker/index.js",
  // Secrets requis (jamais écrits ici) — en local via .dev.vars, en prod via
  // `wrangler secret put <NOM>` :
  //   - STRIPE_SECRET_KEY       clé API Stripe
  //   - STRIPE_WEBHOOK_SECRET   signature du webhook (POST /api/webhook)
  //   - RESEND_API_KEY          envoi de l'email de téléchargement (Resend)
  "compatibility_date": "2025-04-01",
  // nodejs_compat : requis par le SDK Stripe sur le runtime Workers.
  "compatibility_flags": ["nodejs_compat"],
  // Garde l'URL *.workers.dev active en plus du domaine personnalisé.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sans ça, la navigation (clic de lien) vers /api/* tombe sur le fallback
    // SPA (index.html) au lieu d'exécuter le Worker. On force le Worker d'abord.
    "run_worker_first": ["/api/*"]
  },
  // Domaines personnalisés : Cloudflare crée le DNS + le certificat HTTPS.
  "routes": [
    { "pattern": "escape-print.fr", "custom_domain": true },
    { "pattern": "www.escape-print.fr", "custom_domain": true }
  ]
}
